{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [
      "node",
      "eve/workflow-modules"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "agent/**/*.ts",
    "evals/**/*.ts",
    "cloud/**/*.ts",
    "tests/cloud.test.ts",
    "tests/result-schema.test.ts",
    "tests/helpers/**/*.ts",
    "scripts/verify-cloud-dashboard.ts",
    "scripts/verify-cloud-dashboard-container.ts",
    "scripts/cloud-backup.ts",
    "scripts/cloud-smoke.ts",
    "scripts/container-egress-entry.ts",
    "scripts/container-egress-probe.ts",
    "scripts/example-container.ts",
    "scripts/example-pin-probe.ts",
    "scripts/fetch-example-page.ts",
    "scripts/verify-example-pin.ts",
    "scripts/run-example-fetch.ts",
    "scripts/readonly-pilot.ts",
    "scripts/structured-pilot.ts",
    "scripts/structured-container.ts",
    "scripts/structured-document.ts",
    "scripts/structured-pin-probe.ts",
    "scripts/fetch-structured-page.ts",
    "scripts/run-structured-fetch.ts",
    "scripts/verify-structured-pin.ts"
  ]
}
